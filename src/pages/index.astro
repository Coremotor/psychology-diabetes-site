---
import Layout from "layouts/Layout.astro";
import Hero from "components/Hero.astro";
import ClientsTypes from "components/ClientsTypes.astro";
import AboutMe from "components/AboutMe.astro";
import Problems from "components/Problems.astro";
import Experience from "components/Experience.astro";
import Consultation from "components/Consultation.astro";
import Details from "components/Details";
import Therapy from "components/Therapy.astro";
import Carousel from "components/Carousel.astro";
import { diploms, makePhotosArray } from "data/pictures";
import { makeReviewsArray } from "data/pictures";
import ScrollUp from "components/ScrollUp.astro";

import fs from "node:fs";
const filesCount = (dir: string) => fs.readdirSync(dir).length;
---

<Layout title="Клинический психолог с сахарным диабетом" isMainPage={true}>
  <Hero desc="Психологическая поддержка людей с сахарным диабетом" />
  <Experience />
  <Problems />
  <ClientsTypes />
  <AboutMe />
  <Consultation />
  <Details client:load />
  <Therapy />
  <Carousel
    DOMId="education"
    title="Образование"
    images={diploms}
    withLink={true}
    withBackground={true}
    withTitle={true}
    version={1}
  />
  <Carousel
    DOMId="reviews"
    title="Отзывы"
    images={makeReviewsArray(filesCount("./public/assets/images/reviews"))}
    withBackground={false}
    withLink={false}
    withTitle={true}
    version={2}
  />
  <Carousel
    DOMId="gallery"
    title="Галерея"
    images={makePhotosArray(filesCount("./public/assets/images/gallery"))}
    withBackground={true}
    withLink={false}
    withTitle={true}
    version={1}
  />
  <ScrollUp />
</Layout>
