---
import { diplomsRoutes } from "data/routes";
import Layout from "layouts/Layout.astro";
import About from "layouts/About.astro";
import AboutDiplom from "components/AboutDiplom.astro";
import Image from "components/Image.astro";
import Buttons from "components/Buttons.astro";
import { routesList } from "data/routes";
import { nextPage } from "helpers";
import HeroDiplom from "components/HeroDiplom.astro";

const list = [
  "диагностическая деятельность;",
  "лечебная деятельность;",
  "неотложная медицинская помощь на догоспитальном этапе;",
  "профилактическая деятельность;",
  "медико-социальная деятельность;",
  "организационно-аналитическая деятельность.",
];

const desc =
  "Лечебно-диагностическая, медико-профилактическая и медико-социальная помощь населению в системе первичной медико-санитарной помощи; организационно-аналитическая деятельность в рамках учреждений здравоохранения. ";

const next = nextPage(routesList(diplomsRoutes), Astro.url.pathname);
---

<Layout title="Психолог с медицинским образованием" isMainPage={false}>
  <HeroDiplom
    desc="Квалификация - фельдшер по специальности «Лечебное дело»"
    imgUrl="/assets/images/diploms/lechebnoe_delo_1.jpg"
  />
  <Image src="/assets/images/diploms/lechebnoe_delo_2.jpg" />

  <About DOMId="lechebnoe-delo" title="Область профессиональной деятельности">
    <AboutDiplom
      desc={desc}
      list={list}
      diplom="«Неотложные состояния при сахарном диабете»."
      vkr="Выпускная квалификационная работа на тему:"
    />
  </About>

  <Buttons link={next} />
</Layout>
