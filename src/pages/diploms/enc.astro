---
import AboutDiplom from "components/AboutDiplom.astro";
import Buttons from "components/Buttons.astro";
import HeroDiplom from "components/HeroDiplom.astro";
import { diplomsRoutes, routesList } from "data/routes";
import { nextPage } from "helpers";
import About from "layouts/About.astro";
import Layout from "layouts/Layout.astro";

const list = [
	"нормативы, правила и организационно-методические основы обучения пациентов с сахарным диабетом, а также лиц, осуществляющих уход за ними;",
	"основы сахарного диабета, его контроля и лечения включая: принципы питания, физические нагрузки, фармакотерапия, инсулинотерапия, инструментальные технологии в контроле, гипогликемия, острые и хронические осложнения;",
	"техника инъекций инсулина; особенности и принципы непрерывной подкожной инфузии инсулина, контроля глюкозы с использованием систем непрерывного мониторинга глюкозы, проведения и правил оценки знаний по сахарному диабету;",
	"принципы и правила социальной и психологической поддержки пациентов с сахарным диабетом.",
];

const desc =
	"Обучение пациентов является неотъемлемой частью комплекса терапевтических мероприятий при сахарном диабете, которое должно продолжаться на всем протяжении заболевания и необходимо для его эффективного контроля.";

const next = nextPage(routesList(diplomsRoutes), Astro.url.pathname);
---

<Layout title="ЭНЦ" isMainPage={false}>
  <HeroDiplom
    desc="Повышение квалификации - “Ведение школы для больных сахарным диабетом”"
    imgUrl="/assets/images/diploms/enc.jpg"
  />

  <About DOMId="ptsr" title="Область профессиональной деятельности">
    <AboutDiplom desc={desc} list={list} diplom="" vkr="" />
  </About>

  <Buttons link={next} />
</Layout>
