---
import { anchors } from "data/anchors";
import Layout from "layouts/Layout.astro";
import { rootRoutes } from "data/routes";
import Button from "components/Button.astro";

type TItem = {
  price: string;
  name: string;
  desc: string;
  anchor: string;
};

const data: TItem[] = [
  {
    price: "2500 ₽",
    name: "Первая консультация",
    desc: "Знакомимся, уточняем запрос, намечаем план психотерапии. Длительность встречи 90 минут.",
    anchor: anchors.firstConsultation,
  },
  {
    price: "2000 ₽",
    name: "Личная терапия",
    desc: "Индивидуальное консультирование онлайн. Длительность консультации 60 минут.",
    anchor: anchors.personalTherapy,
  },
  {
    price: "от 2000 ₽",
    name: "Детско-родительские отношения",
    desc: "Первая консультация для родителей длится 90 минут. Консультация ребенка длится 60 минут. ",
    anchor: anchors.childParentRelationships,
  },
  {
    price: "5000 ₽",
    name: "Школа диабета для взрослых пациентов, для родителей детей с СД, для детей с СД.",
    desc: "Разовая встреча, длительность 2,5 часа. Бонус: доп. материалы, ссылки на важные ресурсы и приложения.",
    anchor: anchors.diabetesSchool,
  },
  {
    price: "10000 ₽",
    name: "Диа-выгорание, сложности в компенсации диабета",
    desc: "4-недельное сопровождение, помощь в компенсации, психологическая поддержка.",
    anchor: anchors.diaBurnout,
  },
];
---

<Layout title="Тарифы" isMainPage={false}>
  <h2 class="title">Стоимость и виды консультаций</h2>
  <div class="table">
    {
      data.map((item) => (
        <div class="card">
          <div class="price">{item.price}</div>
          <div class="name">{item.name}</div>
          <div class="desc">{item.desc}</div>
          <a
            class="link"
            href={rootRoutes.consultationInfo + "#" + item.anchor}
          >
            <Button title="Подробнее о консультации" />
          </a>
        </div>
      ))
    }

    <div class="card">
      <div class="price">СКИДКА 10%</div>
      <div class="info-wrapper">
        <div class="info">При покупке абонемента</div>
        <div class="info">на 4-8-12 консультаций</div>
      </div>
      <a
        class="link"
        href={rootRoutes.consultationInfo + "#" + anchors.discount}
      >
        <Button title="Подробнее о скидках" />
      </a>
    </div>
  </div>
</Layout>

<style>
  .title {
    text-align: center;
    margin-bottom: 60px;
  }

  .table {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin: 0 auto 60px;
    padding: 0 10px;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-bg-second);
    padding: 40px;
    border-radius: 10px;
    max-width: 500px;
  }

  .price {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 25px;
  }

  .name {
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 25px;
  }

  .desc {
    text-align: center;
    font-size: 18px;
    font-weight: 400;
    margin-bottom: auto;
  }

  .info {
    text-align: center;
    font-size: 32px;
    font-weight: 400;
  }

  .info-wrapper {
    margin-bottom: auto;
  }

  .link {
    margin-top: 60px;
  }

  @media (max-width: 800px) {
    .table {
      grid-template-columns: 1fr;
    }
  }
</style>
