---
import Button from "components/Button.astro";
import { anchors } from "data/anchors";
import { rootRoutes } from "data/routes";
import Layout from "layouts/Layout.astro";

type TItem = {
	price: string;
	name: string;
	desc: string;
	anchor: string;
};

const data: TItem[] = [
	{
		price: "3000 ₽",
		name: "Первая консультация",
		desc: "Знакомимся, уточняем запрос, намечаем план психотерапии. Длительность встречи 90 минут.",
		anchor: anchors.firstConsultation,
	},
	{
		price: "2500 ₽",
		name: "Психологическая работа",
		desc: "Индивидуальное консультирование онлайн. Длительность консультации 60 минут.",
		anchor: anchors.personalTherapy,
	},
	{
		price: "от 2500 ₽",
		name: "Детско-родительские отношения",
		desc: "Первая консультация для родителей длится 90 минут. Консультация ребенка длится 60 минут. ",
		anchor: anchors.childParentRelationships,
	},
	{
		price: "5000 ₽",
		name: "Информационно-психологическая поддержка при диабете",
		desc: "Разбираем практические аспекты жизни с диабетом: понимание принципов самоконтроля (мониторинг, помпа), основы питания и подсчёта углеводов.",
		anchor: anchors.diabetesSchool,
	},
	{
		price: "14000 ₽",
		name: "Работа с выгоранием при диабете: индивидуальная программа психологической поддержки",
		desc: "4-недельное сопровождение, помощь в компенсации, психологическая поддержка.",
		anchor: anchors.diaBurnout,
	},
];
---

<Layout title="Тарифы" isMainPage={false}>
	<h2 class="title">Стоимость и виды консультаций</h2>
	<div class="table">
		{data.map((item) => (
	<div class="card">
		<div class="price">{item.price}</div>
		<div class="name">{item.name}</div>
		<div class="desc">{item.desc}</div>
		<a class="link" href={rootRoutes.consultationInfo + "#" + item.anchor}>
			<Button title="Подробнее о консультации" />
		</a>
	</div>
))}

		<div class="card">
			<div class="price">СКИДКА 10%</div>
			<div class="info-wrapper">
				<div class="info">При покупке абонемента</div>
				<div class="info">на 4-8-12 консультаций</div>
			</div>
			<a
				class="link"
				href={rootRoutes.consultationInfo + "#" + anchors.discount}
			>
				<Button title="Подробнее о скидках" />
			</a>
		</div>
	</div>
</Layout>

<style>
.title {
	text-align: center;
	margin-bottom: 60px;
}

.table {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 40px;
	margin: 0 auto 60px;
	padding: 0 10px;
}

.card {
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: var(--color-bg-second);
	padding: 40px;
	border-radius: 10px;
	max-width: 500px;
}

.price {
	font-size: 36px;
	font-weight: 700;
	margin-bottom: 25px;
}

.name {
	text-align: center;
	font-size: 18px;
	font-weight: 700;
	margin-bottom: 25px;
}

.desc {
	text-align: center;
	font-size: 18px;
	font-weight: 400;
	margin-bottom: auto;
}

.info {
	text-align: center;
	font-size: 32px;
	font-weight: 400;
}

.info-wrapper {
	margin-bottom: auto;
}

.link {
	margin-top: 60px;
}

@media (max-width: 800px) {
	.table {
		grid-template-columns: 1fr;
	}
}
</style>
