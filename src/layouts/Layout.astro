---
import Footer from "components/Footer.astro";
import Header from "components/Header.astro";
import { defaultSeo, seoByPath, siteName, siteUrl } from "data/seo";

export interface Props {
	title: string;
	isMainPage: boolean;
	description?: string;
	keywords?: string[];
	image?: string;
}

const { title, isMainPage, description, keywords, image } = Astro.props;
const pathname = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const pageSeo = seoByPath[pathname] ?? defaultSeo;
const metaTitle = title.includes("|") ? title : `${title} | Ксения Демакова`;
const metaDescription = description ?? pageSeo.description;
const metaKeywords = keywords ?? pageSeo.keywords ?? defaultSeo.keywords;
const metaImage = image ?? pageSeo.image ?? defaultSeo.image;
const canonicalUrl = new URL(pathname, siteUrl).toString();
const absoluteImageUrl = new URL(metaImage, siteUrl).toString();
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: siteUrl,
			name: siteName,
			inLanguage: "ru-RU",
		},
		{
			"@type": "Person",
			"@id": `${siteUrl}/#person`,
			name: "Ксения Демакова",
			jobTitle: "Клинический психолог",
			description:
				"Клинический психолог с личным опытом жизни с сахарным диабетом, специалист по психологической поддержке людей с СД.",
			url: siteUrl,
			image: absoluteImageUrl,
			knowsAbout: [
				"сахарный диабет",
				"клиническая психология",
				"психологическая поддержка при диабете",
				"когнитивно-поведенческая терапия",
				"терапия принятия и ответственности",
				"психология пищевого поведения",
			],
			sameAs: ["https://t.me/clinicpsy_DKA", "https://vk.com/demakovaks"],
		},
		{
			"@type": "ProfessionalService",
			"@id": `${siteUrl}/#service`,
			name: "Психологическая поддержка при сахарном диабете",
			url: siteUrl,
			image: absoluteImageUrl,
			priceRange: "2000-12500 RUB",
			areaServed: "RU",
			availableLanguage: "ru",
			founder: { "@id": `${siteUrl}/#person` },
			serviceType: [
				"Онлайн консультация психолога",
				"Психологическая поддержка при сахарном диабете",
				"КПТ",
				"ACT-терапия",
				"Психология пищевого поведения",
			],
		},
		{
			"@type": "WebPage",
			"@id": `${canonicalUrl}#webpage`,
			url: canonicalUrl,
			name: metaTitle,
			description: metaDescription,
			isPartOf: { "@id": `${siteUrl}/#website` },
			about: { "@id": `${siteUrl}/#person` },
			inLanguage: "ru-RU",
		},
	],
};
---

<!--for sign up consultation pop up-->
<script>
  const popupContainerEl = document.querySelector("#popup-container");
  const popupInnerEl = document.querySelector("#popup-inner");

  popupContainerEl?.addEventListener("click", () => {
    popupContainerEl?.classList.add("popup-display-none");
  });

  popupInnerEl?.addEventListener("click", (event) => {
    event.stopPropagation();
  });

  const buttons = document.querySelectorAll("#popup-button");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      popupContainerEl?.classList.remove("popup-display-none");
    });
  });
</script>
<!--end for sign up consultation pop up-->
<html lang="ru">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DKS5JXDJ04"
    ></script>
    <script is:inline>
      // @ts-nocheck
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("config", "G-DKS5JXDJ04");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords.join(", ")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{metaTitle}</title>
  </head>
  <body>
    <div class="layout-container">
      <Header isMainPage={isMainPage} />
      <slot />
      <Footer isMainPage={isMainPage} />
    </div>

    <script type="text/javascript" is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        (k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a);
      })(
        window,
        document,
        "script",
        "https://mc.yandex.ru/metrika/tag.js",
        "ym",
      );

      ym(90648789, "init", {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true,
      });
    </script>
    <noscript>
      <div>
        <img
          src="https://mc.yandex.ru/watch/90648789"
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div>
      <!-- /Yandex.Metrika counter -->
    </noscript>

    <style is:global>
      :root {
        --font-size-base: calc(0.2vw + 1rem);
        --font-size-lg: calc(0.8vw + 1rem);
        --font-size-xl: calc(2vw + 1rem);

        --color-text: black;
        --color-second-text: white;
        --color-bg: white;
        --color-bg-second: #e6ebf1;
        --color-bg-third: #033277;
        --color-bg-akcent: #922d5f;
      }

      html {
        width: 100%;
        font-family: system-ui, sans-serif;
        font-size: var(--font-size-base);
        color: var(--color-text);
        background-color: var(--color-bg);
      }

      a {
        color: var(--color-text);
      }

      h2 {
        font-size: var(--font-size-lg);
      }

      body {
        min-height: 100vh;
        padding: 0;
        margin: 0;
      }

      .layout-container {
        display: flex;
        flex-direction: column;
        min-width: 360px;
        min-height: 100vh;
        overflow-x: hidden;
        margin: 0 auto;
      }

      @font-face {
        font-family: "Lucida Handwriting";
        src: url("/fonts/lucidahandwriting_italic.ttf") format("truetype");
        font-weight: normal;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: "Comfortaa";
        src: url("/fonts/Comfortaa.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </body>
</html>
<!-- Yandex.Metrika counter -->
