---
import Footer from "components/Footer.astro";
import Header from "components/Header.astro";

export interface Props {
	title: string;
	isMainPage: boolean;
}

const { title, isMainPage } = Astro.props;
---

<!--for sign up consultation pop up-->
<script>
  const popupContainerEl = document.querySelector("#popup-container");
  const popupInnerEl = document.querySelector("#popup-inner");

  popupContainerEl?.addEventListener("click", () => {
    popupContainerEl?.classList.add("popup-display-none");
  });

  popupInnerEl?.addEventListener("click", (event) => {
    event.stopPropagation();
  });

  const buttons = document.querySelectorAll("#popup-button");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      popupContainerEl?.classList.remove("popup-display-none");
    });
  });
</script>
<!--end for sign up consultation pop up-->
