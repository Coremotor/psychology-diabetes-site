---
import About from "layouts/About.astro";

const list = [
	"Поддержка в процессе принятия диагноза СД",
	"Поиск внутренних ресурсов для ежедневной заботы о себе",
	"Работа с отношениями в контексте жизни с диабетом: партнёрство, близость, семья",
	"Сопровождение на этапе планирования беременности",
	"Профилактика эмоционального истощения: стратегии самопомощи",
	"Работа со страхом гипогликемии и тревогой по поводу течения заболевания",
	"Помощь при эпизодах сильной тревоги",
	"Изменение пищевого поведения и отношения к еде",
];
---

<About DOMId="problems" title="Какие проблемы я помогу вам решить">
	<ul class="list">
		{list.map((item) => <li class="item">{item}</li>)}
	</ul>
</About>

<style>
.list {
	padding: 0 40px;
}

.item:not(:last-child) {
	margin-bottom: 10px;
}
</style>
