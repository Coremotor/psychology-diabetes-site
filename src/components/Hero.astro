---
import SignupConsultation from "components/SignupConsultation.astro";
interface Props {
  desc: string;
  imgUrl?: string;
}

const { desc, imgUrl = "/assets/images/hero.png" }: Props = Astro.props;
---

<div class="hero-container">
  <section id="hero" class="hero">
    <div class="desc">
      <span class="text">{desc}</span>

      <SignupConsultation>
        <button class="button">ЗАПИСАТЬСЯ НА КОНСУЛЬТАЦИЮ</button>
      </SignupConsultation>
    </div>

    <picture class="hero-image-container">
      <img class="image" src={imgUrl} alt="hero image" />
    </picture>
  </section>
</div>

<style>
  .hero-container {
    display: flex;
    justify-content: center;
    overflow: visible;
    background: var(--color-bg-third);
    margin-bottom: 80px;
    max-height: 800px;
  }

  .hero {
    display: flex;
    width: 100%;
    max-width: 1600px;
    justify-content: center;
  }

  .hero-image-container {
    width: 100%;
    align-self: flex-end;
  }

  .image {
    width: 100%;
    margin-right: -100px;
  }

  .desc {
    margin-top: 140px;
    margin-right: 40px;
    margin-left: 80px;
    width: 100%;
  }

  .text {
    display: flex;
    font-size: var(--font-size-xl);
    color: #ffffff;
    font-family: "Comfortaa", sans-serif;
    margin-bottom: 80px;
  }

  .button {
    padding: 20px;
    border-radius: 8px;
    background-color: var(--color-bg-akcent);
    color: var(--color-bg);
    font-size: 20px;
    border: none;
  }

  .button:hover {
    cursor: pointer;
  }

  @media (min-width: 1600px) {
    .text {
      font-size: var(--font-size-lg);
    }
  }

  @media (max-width: 1000px) {
    .button {
      padding: 12px;
      font-size: 14px;
    }
  }

  @media (max-width: 900px) {
    .text {
      font-size: 30px;
      margin-bottom: 40px;
    }
    .desc {
      margin-top: 60px;
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    .text {
      font-size: 24px;
      margin-bottom: 40px;
    }
    .button {
      padding: 10px;
      font-size: 12px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .text {
      font-size: 20px;
    }
  }
</style>
