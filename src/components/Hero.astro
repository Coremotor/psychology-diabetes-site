---
interface Props {
  desc: string;
  imgUrl?: string;
}

const { desc, imgUrl = "/assets/images/hero.png" }: Props = Astro.props;
---

<div class="hero-container">
  <section id="hero" class="hero">
    <div class="desc">
      <span class="text">{desc}</span>

      <button class="button">ЗАПИСАТЬСЯ НА КОНСУЛЬТАЦИЮ</button>
    </div>

    <picture class="hero-image-container">
      <img class="image" src={imgUrl} alt="hero image" />
    </picture>
  </section>
</div>

<style>
  .hero-container {
    display: flex;
    justify-content: center;
    overflow: visible;
    background: var(--color-bg-third);
    margin-bottom: 80px;
  }

  .hero {
    display: flex;
    width: 100%;
    max-width: 1600px;
    justify-content: center;
  }

  .hero-image-container {
    width: 100%;
    align-self: flex-end;
  }

  .image {
    width: 100%;
    margin-right: -100px;
  }

  .desc {
    margin-top: 140px;
    margin-right: 40px;
    margin-left: 80px;
    width: 100%;
  }

  .text {
    display: flex;
    font-size: var(--font-size-xl);
    color: #ffffff;
    font-family: "Comfortaa", sans-serif;
    margin-bottom: 80px;
  }

  .button {
    padding: 20px;
    border-radius: 8px;
    background-color: var(--color-bg-akcent);
    color: var(--color-bg);
    font-size: 20px;
    border: none;
  }

  .button:hover {
    cursor: pointer;
  }

  @media (min-width: 1600px) {
    .text {
      font-size: 50px;
    }
  }

  @media (max-width: 1100px) {
    .text {
      font-size: 40px;
    }
  }

  @media (max-width: 520px) {
    .text {
      font-size: 30px;
    }
  }
</style>
