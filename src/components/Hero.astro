---
interface Props {
	desc: string;
	imgUrl?: string;
}

const { desc, imgUrl = "/assets/images/hero.png" }: Props = Astro.props;
---

<div class="hero-container">
  <section id="hero" class="hero">
    <div class="desc">
      <span class="text">{desc}</span>

      <a href="/tariffs">
        <button class="button">ЗАПИСАТЬСЯ НА КОНСУЛЬТАЦИЮ</button>
      </a>
    </div>

    <picture class="hero-image-container">
      <img class="image" src={imgUrl} alt="hero image" />
    </picture>
  </section>
</div>

<style>
  .hero-container {
    display: flex;
    justify-content: center;
    overflow: visible;
    background: var(--color-bg-third);
    margin-bottom: 80px;
    max-height: 800px;
  }

  .hero {
    display: flex;
    width: 100%;
    max-width: 1100px;
    justify-content: center;
  }

  .hero-image-container {
    display: flex;
    width: 100%;
    align-self: flex-end;
  }

  .desc {
    display: flex;
    flex-direction: column;
    margin-top: 140px;
    margin-right: 40px;
    width: 100%;
  }

  .text {
    width: 100%;
    display: flex;
    font-size: 46px;
    color: #ffffff;
    font-family: "Comfortaa", sans-serif;
    margin-bottom: 80px;
  }

  .button {
    padding: 20px;
    border-radius: 8px;
    background-color: var(--color-bg-akcent);
    color: var(--color-bg);
    font-size: 20px;
    border: none;
  }

  .button:hover {
    cursor: pointer;
  }

  @media (max-width: 1200px) {
    .hero-container {
      padding: 0 40px;
    }

    .image {
      width: 100%;
    }

    .text {
      font-size: 40px;
    }
  }

  @media (max-width: 1000px) {
    .button {
      padding: 12px;
      font-size: 14px;
    }
  }

  @media (max-width: 920px) {
    .text {
      font-size: 30px;
      margin-bottom: 40px;
    }
    .desc {
      margin-top: 100px;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .text {
      font-size: 24px;
      margin-bottom: 40px;
    }
    .button {
      padding: 10px;
      font-size: 12px;
    }
    .desc {
      margin-top: 60px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      flex-direction: column;
      align-items: center;
    }

    .text {
      text-align: center;
      font-size: 28px;
    }

    .desc {
      align-items: center;
      margin-right: 0;
    }

    .hero-image-container {
      justify-content: center;
    }

    .image {
      width: 80%;
    }
  }

  @media (max-width: 520px) {
    .text {
      font-size: 24px;
    }
  }
</style>
