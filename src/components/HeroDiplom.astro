---
interface Props {
	desc: string;
	imgUrl: string;
}

const { desc, imgUrl }: Props = Astro.props;
---

<div class="hero-container">
  <section id="hero" class="hero">
    <div class="desc">
      <span class="text">{desc}</span>
    </div>

    <picture class="hero-image-container">
      <img class="image" src={imgUrl} alt="diplom image" />
    </picture>
  </section>
</div>

<style>
  .hero-container {
    display: flex;
    justify-content: center;
    overflow: visible;
    background: var(--color-bg-third);
    margin-bottom: 80px;
    max-height: 800px;
    padding: 100px 0;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 40px;
    width: 100%;
    max-width: 1100px;
    justify-content: center;
  }

  .desc {
    display: flex;
    align-items: center;
  }

  .image {
    width: 100%;
    max-width: 600px;
  }

  .text {
    font-size: 46px;
    color: #ffffff;
    font-family: "Comfortaa", sans-serif;
  }

  @media (max-width: 1200px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .text {
      font-size: 40px;
      text-align: center;
    }
  }

  @media (max-width: 800px) {
    .hero-container {
      padding: 50px 10px;
    }
    .text {
      font-size: 30px;
      text-align: center;
    }
  }
</style>
