---
import About from "layouts/About.astro";

const list = [
	"Вместе мы сформулируем суть запроса и определим возможные направления работы.",
	"Вы получите практические знания и инструменты, которые сможете применять в повседневной жизни.",
	"В атмосфере принятия и поддержки вы сможете исследовать свои внутренние ресурсы.",
	"Мы исследуем ваше отношение к диагнозу и найдём новые смыслы в жизни с диабетом.",
	"Мы освоим техники работы с мыслями и убеждениями, которые помогут вам справляться со страхами.",
	"Я помогу вам обнаружить ваши сильные стороны и опереться на них в процессе изменений.",
];
---

<About
	DOMId="consultation"
	title="Что вы получите в результате онлайн-консультации?"
>
	<section id="consultation" class="consultation">
		<ul class="list">
			{list.map((item, index) => (
	<li class="item">
		<div class="number">{index + 1}</div>
		<div class="desc">{item}</div>
	</li>
))}
		</ul>
	</section>
</About>

<style>
.consultation {
	max-width: 1180px;
	padding: 0 10px;
	margin: 0 auto;
}

.list {
	display: grid;
	grid-template-columns: 1fr 1fr;
	row-gap: 30px;
	column-gap: 120px;
	justify-items: center;
	padding-right: 40px;
}

.item {
	display: flex;
	align-items: center;
}

.number {
	color: var(--color-bg-third);
	font-family: "Lucida Handwriting", sans-serif;
	font-style: italic;
	font-size: 100px;
	font-weight: 700;
	margin-right: 30px;
}

@media (max-width: 860px) {
	.list {
		grid-template-columns: 1fr;
		justify-items: start;
		row-gap: 0;
		column-gap: 0;
	}

	.item:not(:last-child) {
		margin-bottom: 20px;
	}
}
</style>
